[Unit]
Description=Contexa local context engine daemon
Documentation=https://github.com/peter-njoro/contexa
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/contexad
Restart=on-failure
RestartSec=5s

# Run as the current user (user-level systemd service)
# Install with: systemctl --user enable contexad.service
# Start with:   systemctl --user start contexad.service

StandardOutput=journal
StandardError=journal
SyslogIdentifier=contexad

[Install]
WantedBy=default.target
