<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.contexa.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/contexad</string>
    </array>

    <!-- Run at login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Restart on crash -->
    <key>KeepAlive</key>
    <dict>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/contexad.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/contexad.stderr.log</string>

    <!--
    Install with:
      cp com.contexa.daemon.plist ~/Library/LaunchAgents/
      launchctl load ~/Library/LaunchAgents/com.contexa.daemon.plist

    Uninstall with:
      launchctl unload ~/Library/LaunchAgents/com.contexa.daemon.plist
      rm ~/Library/LaunchAgents/com.contexa.daemon.plist
    -->
</dict>
</plist>
